{
  "Logging": { "LogLevel": { "Default": "Warning", "Aegi": "Information" } },
  "Authentication": {
    "Mode": "Entra",
    "TenantId": "<prod-tenant-id>",
    "ApiAudience": "api://<prod-api-client-id>",
    "SpaClientId": "<prod-spa-client-id>"
  },
  "Reporting": { "Source": "Fabric" },
  "Fabric": {
    "SqlEndpoint": "<prod-workspace>.datawarehouse.fabric.microsoft.com",
    "Database": "<prod-lakehouse-name>",
    "ClientId": "<prod-fabric-service-principal-client-id>"
  },
  "KeyVault": { "Uri": "https://<prod-key-vault>.vault.azure.net/" }
}
