{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",

  "Authentication": {
    "Mode": "Entra",
    "TenantId": "",
    "ApiAudience": "",
    "ApiClientId": "",
    "RequiredScope": "Dashboard.Read",
    "RequiredRole": "Dashboard.Viewer",
    "SpaClientId": ""
